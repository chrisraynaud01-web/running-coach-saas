// Prisma schema — Running Coach SaaS
// Plateforme de coaching en course à pied (coach <-> athlètes)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================================================================
// AUTH (Auth.js / NextAuth — Prisma Adapter)
// =========================================================================

enum UserRole {
  ADMIN
  COACH
  ATHLETE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(ATHLETE)

  createdAt DateTime @updatedAt @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  coachProfile   Coach?
  athleteProfile Athlete?

  sentMessages       Message[]      @relation("MessageSender")
  notifications      Notification[]
  uploadedDocuments  Document[]     @relation("DocumentUploadedBy")
  integrationAccounts IntegrationAccount[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =========================================================================
// COACH / ATHLETE
// =========================================================================

model Coach {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio   String?
  phone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athletes      Athlete[]
  trainingPlans TrainingPlan[]
  workouts      Workout[]       @relation("WorkoutCreatedByCoach")
  conversations Conversation[]

  @@map("coaches")
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum AthleteStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Athlete {
  id     String  @id @default(cuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  coachId String
  coach   Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)

  // Informations
  firstName String
  lastName  String
  email     String
  phone     String?
  birthDate DateTime?
  sex       Sex?
  heightCm  Float?
  weightKg  Float?

  status AthleteStatus @default(ACTIVE)
  notes  String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?

  goals           Goal[]
  metricsHistory  AthleteMetrics[]
  trainingPlans   TrainingPlan[]
  workouts        Workout[]
  journalEntries  JournalEntry[]
  documents       Document[]
  events          Event[]
  conversation    Conversation?
  integrationAccounts IntegrationAccount[]

  @@index([coachId])
  @@map("athletes")
}

// Données sportives, versionnées dans le temps (progression)
enum MetricSource {
  MANUAL
  GARMIN
  STRAVA
  POLAR
  COROS
  SUUNTO
}

model AthleteMetrics {
  id        String   @id @default(cuid())
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  recordedAt DateTime @default(now())

  vma               Float? // km/h
  maxHeartRate      Int?
  restingHeartRate  Int?
  pace5k            Int? // secondes / km
  pace10k           Int?
  paceHalfMarathon  Int?
  paceMarathon      Int?
  weightKg          Float?

  source MetricSource @default(MANUAL)
  notes  String?

  createdAt DateTime @default(now())

  @@index([athleteId, recordedAt])
  @@map("athlete_metrics")
}

// =========================================================================
// OBJECTIFS
// =========================================================================

enum GoalType {
  RACE
  PERFORMANCE
  HEALTH
  OTHER
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
}

model Goal {
  id        String  @id @default(cuid())
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  title       String
  description String?    @db.Text
  type        GoalType   @default(RACE)
  targetDate  DateTime?
  targetValue String? // ex: "Marathon sub 3h30"
  isPrimary   Boolean    @default(false)
  status      GoalStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events        Event[]
  trainingPlans TrainingPlan[]

  @@index([athleteId])
  @@map("goals")
}

// =========================================================================
// PLANIFICATION : PLANS, SÉANCES, BLOCS
// =========================================================================

enum TrainingPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

model TrainingPlan {
  id        String  @id @default(cuid())
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  coachId String
  coach   Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)

  goalId String?
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)

  name        String
  description String?             @db.Text
  startDate   DateTime
  endDate     DateTime
  status      TrainingPlanStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workouts Workout[]

  @@index([athleteId])
  @@index([coachId])
  @@map("training_plans")
}

enum WorkoutType {
  ENDURANCE_FONDAMENTALE
  SEUIL
  VMA
  FRACTIONNE_COURT
  FRACTIONNE_LONG
  SORTIE_LONGUE
  RECUPERATION
  RENFORCEMENT
  COMPETITION
  AUTRE
}

enum WorkoutStatus {
  PLANNED
  COMPLETED
  SKIPPED
  MODIFIED
}

model Workout {
  id             String        @id @default(cuid())
  athleteId      String
  athlete        Athlete       @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  trainingPlanId String?
  trainingPlan   TrainingPlan? @relation(fields: [trainingPlanId], references: [id], onDelete: SetNull)

  createdByCoachId String
  createdByCoach   Coach  @relation("WorkoutCreatedByCoach", fields: [createdByCoachId], references: [id], onDelete: Cascade)

  title         String
  type          WorkoutType   @default(AUTRE)
  status        WorkoutStatus @default(PLANNED)
  scheduledDate DateTime

  // Prévu
  plannedDistanceMeters Int?
  plannedDurationSeconds Int?

  // Réalisé (retour athlète / import capteur)
  actualDistanceMeters  Int?
  actualDurationSeconds Int?
  actualAverageHeartRate Int?
  completedAt           DateTime?

  coachNotes   String? @db.Text
  athleteNotes String? @db.Text

  // Regroupe les séances créées via "dupliquer" / "répéter"
  seriesId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocks              WorkoutBlock[]
  journalEntries      JournalEntry[]
  integrationActivities IntegrationActivity[]

  @@index([athleteId, scheduledDate])
  @@index([trainingPlanId])
  @@index([seriesId])
  @@map("workouts")
}

enum WorkoutBlockType {
  ECHAUFFEMENT
  CORPS_DE_SEANCE
  RETOUR_AU_CALME
}

enum Intensity {
  FAIBLE
  MODEREE
  ELEVEE
  MAXIMALE
}

model WorkoutBlock {
  id        String  @id @default(cuid())
  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  exerciseId String?
  exercise   Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  type  WorkoutBlockType
  order Int

  label       String? // ex: "10 x 400m à VMA"
  description String? @db.Text

  sets        Int? // nombre de séries (ex : le "2" dans "2 x (4 x 600m)")
  repetitions Int? // répétitions par série (ex : le "4" dans "4 x 600m")
  distanceMeters  Int?
  durationSeconds Int?
  vmaPercent  Int? // allure exprimée en % de la VMA de l'athlète au moment de la création
  paceTargetSecPerKm Int? // allure cible calculée (secondes/km), dérivée de vmaPercent ou saisie directement
  intensity   Intensity?

  recoveryDurationSeconds    Int? // récupération entre répétitions au sein d'une série (ex : "r:1'15")
  recoveryBetweenSetsSeconds Int? // récupération entre séries (ex : "R:3'")
  recoveryDistanceMeters     Int?

  notes String? @db.Text

  // Retour de l'athlète après réalisation de la séance
  actualDurationSeconds Int?
  actualRepSecondsList  Int[] @default([]) // temps réalisé par répétition (aligné sur sets x repetitions)
  actualNotes           String? @db.Text

  @@index([workoutId])
  @@map("workout_blocks")
}

// =========================================================================
// BIBLIOTHÈQUE D'EXERCICES
// =========================================================================

enum ExerciseCategory {
  ENDURANCE_FONDAMENTALE
  SEUIL
  VMA
  FRACTIONNE_COURT
  FRACTIONNE_LONG
  SORTIE_LONGUE
  RECUPERATION
  GAINAGE
  SQUATS
  FENTES
  CORE_TRAINING
  AUTRE
}

model Exercise {
  id String @id @default(cuid())

  name        String
  description String?          @db.Text
  category    ExerciseCategory
  instructions String?         @db.Text // consignes
  intensity   Intensity?

  isSystem  Boolean  @default(false) // exercice fourni par défaut vs créé par un coach
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workoutBlocks WorkoutBlock[]

  @@map("exercises")
}

// =========================================================================
// JOURNAL D'ENTRAÎNEMENT
// =========================================================================

model JournalEntry {
  id        String  @id @default(cuid())
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  workoutId String?
  workout   Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)

  date    DateTime @default(now())
  rpe     Int? // ressenti 1-10
  fatigue Int? // 1-10
  sleepQuality Int? // 1-10
  sleepHours   Float?
  stress  Int? // 1-10
  comment String? @db.Text

  createdAt DateTime @default(now())

  @@index([athleteId, date])
  @@map("journal_entries")
}

// =========================================================================
// ÉVÈNEMENTS (courses, stages...)
// =========================================================================

enum EventType {
  RACE
  TRAINING_CAMP
  OTHER
}

model Event {
  id        String  @id @default(cuid())
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  goalId String?
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)

  name     String
  type     EventType @default(RACE)
  date     DateTime
  location String?
  notes    String?   @db.Text

  createdAt DateTime @default(now())

  @@index([athleteId, date])
  @@map("events")
}

// =========================================================================
// MESSAGERIE
// =========================================================================

model Conversation {
  id String @id @default(cuid())

  coachId String
  coach   Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)

  athleteId String  @unique
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([coachId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  content       String  @db.Text
  attachmentUrl String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

// =========================================================================
// GESTION DOCUMENTAIRE
// =========================================================================

enum DocumentType {
  PDF
  PHOTO
  NUTRITION_PLAN
  MEDICAL_REPORT
  OTHER
}

model Document {
  id        String  @id @default(cuid())
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)

  name        String
  type        DocumentType
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  description String?      @db.Text

  createdAt DateTime @default(now())

  @@index([athleteId])
  @@map("documents")
}

// =========================================================================
// NOTIFICATIONS
// =========================================================================

enum NotificationType {
  MESSAGE
  WORKOUT_REMINDER
  GOAL_DEADLINE
  INJURY_ALERT
  ATHLETE_INACTIVE
  SYSTEM
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String?
  link  String?

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// =========================================================================
// INTÉGRATIONS TIERCES (Garmin, Strava, Polar, Coros, Suunto)
// Abstraction générique pour brancher de futurs connecteurs.
// =========================================================================

enum IntegrationProvider {
  GARMIN
  STRAVA
  POLAR
  COROS
  SUUNTO
}

model IntegrationAccount {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  athleteId String?
  athlete   Athlete? @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  provider       IntegrationProvider
  externalUserId String?
  accessToken    String?             @db.Text
  refreshToken   String?             @db.Text
  expiresAt      DateTime?
  scope          String?

  connectedAt   DateTime  @default(now())
  lastSyncedAt  DateTime?

  activities IntegrationActivity[]

  @@unique([userId, provider])
  @@map("integration_accounts")
}

model IntegrationActivity {
  id                   String              @id @default(cuid())
  integrationAccountId String
  integrationAccount   IntegrationAccount  @relation(fields: [integrationAccountId], references: [id], onDelete: Cascade)

  provider    IntegrationProvider
  externalId  String

  startedAt        DateTime
  distanceMeters    Int?
  durationSeconds   Int?
  averageHeartRate  Int?
  elevationGainMeters Int?
  raw               Json?

  matchedWorkoutId String?
  matchedWorkout   Workout? @relation(fields: [matchedWorkoutId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([provider, externalId])
  @@index([integrationAccountId])
  @@map("integration_activities")
}
